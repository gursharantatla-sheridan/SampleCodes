@page "/products"
@rendermode InteractiveServer
@inject ProductService ProductService

<PageTitle>Products</PageTitle>

<h3>Products</h3>

<div class="row mb-3">

    <!-- Search box -->
    <div class="col-md-4">
        <label>Search by Product Name:</label>
        <input type="text" @bind="searchKeyword" class="form-control" />
    </div>

    <!-- Search button -->
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="SearchByName">Search</button>
    </div>

    <!-- Category dropdown -->
    <div class="col-md-4">
        <label>Filter by Category:</label>
        <select class="form-select" @onchange="OnCategoryChanged">
            <option value="0">-- All Categories --</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
    </div>
</div>

<!-- Products table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Product Id</th>
            <th>Name</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in products)
        {
            <tr>
                <td>@p.ProductId</td>
                <td>@p.ProductName</td>
                <td>@p.Category?.CategoryName</td>
            </tr>
        }
    </tbody>
</table>


@code {
    private string searchKeyword = "";
    private int catId = 0;
    
    private List<Category> categories = new();
    private List<Product> products = new();

    protected override void OnInitialized()
    {
        // load all categories and all products
        categories = ProductService.GetCategories();
        products = ProductService.GetProducts();
    }

    private void SearchByName()
    {
        products = ProductService.GetProductsByName(searchKeyword);
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    { 
        catId = Convert.ToInt32(e.Value);
        products = ProductService.GetProductsByCategory(catId);
    }
}

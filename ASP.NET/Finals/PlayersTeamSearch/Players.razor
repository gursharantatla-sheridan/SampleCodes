@page "/players"
@rendermode InteractiveServer
@inject SoccerService SoccerService

<h3>Players</h3>

<div class="row mb-3">

    <!-- Search text box -->
    <div class="col-md-4">
        <label>Search Players by Name:</label>
        <input type="text" class="form-control" />
    </div>

    <!-- Search button -->
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100">Search</button>
    </div>

    <!-- Teams dropdown -->
    <div class="col-md-4">
        <label>Filter by Team:</label>
        <select class="form-select">
            <option value="-1">-- All Teams --</option>
            <!-- add a foreach loop here to add teams to the dropdown -->
        </select>
    </div>
</div>

<!-- Players table -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Player Id</th>
            <th>Player Name</th>
            <th>Position</th>
            <th>Team</th>
        </tr>
    </thead>
    <tbody>
        <!-- add a foreach loop here to add players to the table -->
    </tbody>
</table>



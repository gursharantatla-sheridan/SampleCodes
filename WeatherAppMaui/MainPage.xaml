<ScrollView>
    <VerticalStackLayout x:Name="stack" 
                         Spacing="10" 
                         BackgroundColor="{StaticResource MidnightBlue}">

        <Label x:Name="CityLbl" 
               HorizontalOptions="Center" 
               FontSize="20"
               TextColor="White"/>

        <Label x:Name="TemperatureLbl" 
               HorizontalOptions="Center" 
               FontSize="50"
               TextColor="White"/>

        <Label x:Name="ConditionsLbl" 
               HorizontalOptions="Center" 
               FontSize="20"
               TextColor="White"/>

        <Image x:Name="WeatherImg"
               WidthRequest="200"
               HeightRequest="200"
               HorizontalOptions="Center" />

        <Button x:Name="GetWeatherBtn" 
                Text="Get Weather" 
                Margin="20"
                Clicked="OnGetWeatherBtnClicked" />

    </VerticalStackLayout>
</ScrollView>

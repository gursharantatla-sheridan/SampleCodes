<ScrollView>
    <VerticalStackLayout x:Name="stack" Spacing="10" BackgroundColor="{StaticResource Primary}">

        <Label x:Name="CityLbl" 
               HorizontalOptions="Center" 
               FontSize="20"/>
        
        <Label x:Name="TemperatureLbl" 
               HorizontalOptions="Center" 
               FontSize="50"/>
        
        <Label x:Name="ConditionsLbl" 
               HorizontalOptions="Center" 
               FontSize="20"/>

        <Image x:Name="WeatherImg"
               WidthRequest="200"
               HeightRequest="200"
               HorizontalOptions="Center" />

        <Button x:Name="GetWeatherBtn" 
                Text="Get Weather" 
                VerticalOptions="End"
                Margin="20"
                Clicked="OnGetWeatherBtnClicked" />
        
    </VerticalStackLayout>
</ScrollView>

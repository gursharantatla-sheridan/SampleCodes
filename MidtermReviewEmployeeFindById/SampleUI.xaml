<Canvas Background="AliceBlue">

    <GroupBox Header="Employee Type" Height="159" Width="228" Canvas.Left="57" Canvas.Top="31" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Margin="5">
            <RadioButton x:Name="rdoHrEmp" Content="Hourly" Canvas.Left="10" Canvas.Top="14" Margin="5" IsChecked="True"/>
            <RadioButton x:Name="rdoCommEmp" Content="Commission" Canvas.Left="10" Canvas.Top="39" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
            <RadioButton x:Name="rdoSalPlusCommEmp" Content="Salary + Commission" Canvas.Left="10" Canvas.Top="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
            <Button x:Name="btnGetEmps" Content="Get Employees" Margin="5"/>
        </StackPanel>
    </GroupBox>

    <DataGrid x:Name="grdEmployees" Height="147" Width="689" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="57" Canvas.Top="242" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    <Label Content="Employee Id" Canvas.Right="350" Canvas.Top="27" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <TextBox x:Name="txtEmployeeId" Canvas.Left="455" TextWrapping="NoWrap" Canvas.Top="31" Width="76" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Button x:Name="btnFind" Content="Find" Canvas.Left="536" Canvas.Top="30" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="44"/>
    
    <Label Content="Name" Canvas.Right="350" Canvas.Top="64" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Label x:Name="lblName" Content="" Canvas.Left="455" Canvas.Top="63" HorizontalAlignment="Left" VerticalAlignment="Center" Width="125" BorderBrush="Black" BorderThickness="1"/>
    
    <Label x:Name="hoursOrGrossSalesLabel" Content="Hours" Canvas.Right="350" Canvas.Top="99" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Label x:Name="lblHoursOrGrossSales" Content="" Canvas.Left="455" Canvas.Top="98" Width="125" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    
    <Label x:Name="wageOrCommRateLabel" Content="Wage" Canvas.Right="350" Canvas.Top="136" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Label x:Name="lblWageOrCommRate" Content="" Canvas.Left="455" Canvas.Top="135" Width="125" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    
    <Label x:Name="salaryLabel" Content="Salary" Canvas.Right="350" Canvas.Top="174" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Label x:Name="lblSalary" Content="" Canvas.Left="455" Canvas.Top="173" Width="125" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>

    <Label Content="Gross Earnings" Canvas.Left="616" Canvas.Top="137" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <Label x:Name="lblGrossEarnings" Content="" Canvas.Left="606" Canvas.Top="173" Width="140" BorderBrush="Black" BorderThickness="1" Background="CornflowerBlue" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"/>
    
</Canvas>

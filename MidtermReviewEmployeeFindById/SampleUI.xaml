<Canvas Background="AliceBlue">

    <GroupBox Header="Employee Type" Height="137" Width="228" Canvas.Left="80" Canvas.Top="27" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold">
        <StackPanel Margin="5">
            <RadioButton x:Name="rdoHrEmp" Content="Hourly" Canvas.Left="10" Canvas.Top="14" Margin="5" IsChecked="True"/>
            <RadioButton x:Name="rdoCommEmp" Content="Commission" Canvas.Left="10" Canvas.Top="39" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
            <Button x:Name="btnGetEmps" Content="Get Employees" Margin="5"/>
        </StackPanel>
    </GroupBox>

    <DataGrid x:Name="grdEmployees" Height="147" Width="616" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="80" Canvas.Top="245" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>

    <Label Content="Employee Id" Canvas.Right="300" Canvas.Top="17" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    <TextBox x:Name="txtEmployeeId" Canvas.Left="496" TextWrapping="NoWrap" Canvas.Top="20" Width="95" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold" Height="25"/>
    <Button x:Name="btnFind" Content="Find" Canvas.Left="596" Canvas.Top="20" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" IsDefault="True" FontSize="16" FontWeight="Bold"/>

    <Label Content="Name" Canvas.Right="300" Canvas.Top="54" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    <Label x:Name="lblName" Content="" Canvas.Left="496" Canvas.Top="50" HorizontalAlignment="Center" VerticalAlignment="Top" Width="200" FontSize="16" FontWeight="Bold" BorderBrush="Black" BorderThickness="1"/>

    <Label x:Name="hoursOrGrossSalesLabel" Content="Hours" Canvas.Right="300" Canvas.Top="89" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    <Label x:Name="lblHoursOrGrossSales" Content="" Canvas.Left="496" Canvas.Top="88" Width="200" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>

    <Label x:Name="wageOrCommRateLabel" Content="Wage" Canvas.Right="300" Canvas.Top="126" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    <Label x:Name="lblWageOrCommRate" Content="" Canvas.Left="496" Canvas.Top="125" Width="200" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>

    <CheckBox x:Name="chkIsUnionMember" Content="Union Member" Canvas.Left="496" Canvas.Top="165" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>

    <Label Content="Gross Earnings" Canvas.Right="300" Canvas.Top="195" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    <Label x:Name="lblGrossEarnings" Content="" Canvas.Left="496" Canvas.Top="194" Width="200" BorderBrush="Black" BorderThickness="1" Background="CornflowerBlue" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
    
</Canvas>
